# Copy to .env and fill in. Nothing here is required to try a dry run.

# --- Search area ---
# Amazon YVR14 = 402 Dunsmuir St, Vancouver BC. OSM has no rooftop pin for this
# address, so this is a street-level estimate — run scripts/check_office.py and
# adjust if the map pin isn't on the building.
OFFICE_LAT=49.2806
OFFICE_LON=-123.1116

# How far you're willing to walk, in minutes. The search radius in metres is
# derived from this, allowing for real routes being ~25% longer than a straight
# line. Adjustable from the dashboard too.
WALK_MINUTES=10

MIN_BEDROOMS=0          # 0 includes studios
MAX_BEDROOMS=1
MAX_PRICE=0             # 0 = no cap
POLL_MINUTES=10

# --- How you want to be alerted ---
# "email" needs only the Gmail App Password below - no phone number, no paid
# account, no public URL. "sms" additionally needs a PAID Twilio account: trial
# accounts can only send canned templates, so listing alerts get rejected.
# "both" does each.
NOTIFY_CHANNEL=email

# --- Email: alerts to you, intros to landlords, and reading your replies ---
# One credential does all three. Gmail needs an App Password, NOT your account
# password: Google Account > Security > 2-Step Verification > App passwords.
# Turning that on also enables IMAP, which is how your replies are read.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Where alerts land. Leave blank to email yourself at SMTP_USER.
ALERT_EMAIL=

# Replying to an alert email is what triggers the intro. Checked over IMAP, so no
# tunnel or webhook is needed. Set WATCH_INBOX=0 to turn the whole thing off.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
INBOX_POLL_SECONDS=60
WATCH_INBOX=1

REPLY_SUBJECT=Vivian - interested in your rental listing

# --- Twilio: only needed if NOTIFY_CHANNEL includes "sms" ---
# From the console home page under "Account Info". The Auth Token is required
# even with an API key, because Twilio signs inbound webhooks with it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional restricted key; Messaging > Messages > Create is the only permission.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM=            # the number you rent FROM Twilio
MY_PHONE=               # YOUR cell, where texts arrive

# When you can view a place. Substituted into {availability} below, so you can
# change your viewing hours without touching the rest of the message.
AVAILABILITY=on weekday evenings after 6pm, and most of the weekend

# Fill in every [BRACKETED] placeholder before you use this. Anything left in
# brackets will be sent literally, and the household/pet line is a claim about
# you that only you can make truthfully. Keep the whole thing under ~1500
# characters; the Craigslist relay silently truncates longer replies.
REPLY_MESSAGE="Hi, is this still available? I'd love to see it - I'm free {availability}.

A bit about me: I'm Vivian, and I work downtown just a few blocks away. Looking to move in [MOVE-IN DATE], [just me / me and my partner], [no pets / one cat], non-smoker. Happy to provide references, proof of income, and a credit check.

You can reach me at [YOUR PHONE] or [YOUR EMAIL], or just reply here.

Thanks!
Vivian"

# Set to 1 to log texts and emails instead of sending them.
DRY_RUN=0

# Playwright profile reused across replies so captcha trust can accumulate.
BROWSER_PROFILE_DIR=.browser-profile

# Look up how old each building is (City of Vancouver open data). Set 0 to skip.
LOOKUP_YEAR_BUILT=1
